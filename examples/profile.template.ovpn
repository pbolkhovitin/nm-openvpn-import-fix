# Шаблон клиентского OpenVPN-профиля для импорта в NetworkManager.
# Секретов здесь нет: подставьте свои значения вручную.
#
# ВАЖНО: НЕ используйте inline-блок
#   <auth-user-pass>
#   login
#   password
#   </auth-user-pass>
# NetworkManager-openvpn его не поддерживает (ошибка "неподдерживаемый элемент blob/xml").
# Используйте bare-директиву — NM спросит логин и пароль при подключении.

client
dev tun
proto udp
remote vpn.example.com 1194 udp

tls-client
remote-cert-tls server
nobind
persist-key
persist-tun
ping 15
ping-restart 45
reneg-sec 3600

# Без аргумента: NetworkManager запросит учётные данные.
auth-user-pass

# Шифры должны совпадать с сервером.
cipher AES-128-CBC
auth SHA1

# MTU: подберите под реальный path MTU (проверка: ping -M do -s <size> <host>).
# mssfix должен быть <= path_mtu - 40.
tun-mtu 1400
mssfix 1360

# Inline-сертификаты NM поддерживает и сам извлекает их в PEM.
<ca>
ВСТАВЬТЕ_CA_СЕРТИФИКАТ
</ca>
<cert>
ВСТАВЬТЕ_КЛИЕНТСКИЙ_СЕРТИФИКАТ
</cert>
<key>
ВСТАВЬТЕ_ЗАКРЫТЫЙ_КЛЮЧ
</key>
